{
  "name": "codex-reset-reminder",
  "desktopName": "com.adgai.codexresetreminder.desktop",
  "version": "2.0.0-beta.1",
  "description": "Codex 重置卡到期提醒（跨平台桌面版）",
  "author": {
    "name": "Adgai115",
    "email": "Adgai115@users.noreply.github.com"
  },
  "homepage": "https://github.com/Adgai115/codex-reset-reminder",
  "repository": "https://github.com/Adgai115/codex-reset-reminder.git",
  "type": "module",
  "main": "desktop/main.mjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"./**/*.test.mjs\"",
    "probe:sqlite": "node desktop/check-electron-sqlite.mjs",
    "prepare:sidecar": "node desktop/prepare-sidecar.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "dist:dir": "npm run prepare:sidecar && electron-builder --dir --publish never",
    "dist": "npm run prepare:sidecar && electron-builder --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.adgai.codexresetreminder",
    "productName": "Codex Reset Reminder",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "ui/**/*",
      "core/**/*",
      "assets/**/*",
      "check.mjs",
      "sync.mjs",
      "remind.mjs",
      "preflight-sync.mjs",
      "plan-next.mjs",
      "consume.mjs",
      "replan.mjs",
      "store.mjs",
      "native-bin.mjs",
      "feishu.mjs",
      "wechat.mjs",
      "reminder-policy.mjs",
      "later.mjs",
      "config.example.json",
      "package.json",
      "!**/*.test.mjs"
    ],
    "extraResources": [
      {
        "from": "vendor-node",
        "to": "vendor-node"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/app-icon-source.png",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/app-icon-source.png",
      "category": "Utility",
      "syncDesktopName": true
    }
  }
}
